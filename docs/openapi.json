{
  "openapi": "3.1.0",
  "info": {
    "title": "Audio Analysis API",
    "description": "High-quality music analysis using Essentia C++ core via Python.",
    "version": "3.0.1"
  },
  "paths": {
    "/analyze/rhythm": {
      "post": {
        "tags": ["Analysis"],
        "summary": "Analyze Rhythm",
        "description": "Extract BPM, beats, confidence, and high-quality onsets.",
        "operationId": "analyze_rhythm_analyze_rhythm_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_file_upload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RhythmAnalysis"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing API key"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/analyze/structure": {
      "post": {
        "tags": ["Analysis"],
        "summary": "Analyze Structure",
        "description": "Segment audio into sections (intro, verse, chorus, etc.) using SBic.",
        "operationId": "analyze_structure_analyze_structure_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_file_upload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StructureAnalysis"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing API key"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/analyze/classification": {
      "post": {
        "tags": ["Analysis"],
        "summary": "Analyze Classification",
        "description": "Analyze Genre, Mood, Tags, and additional classification features using Essentia TensorFlow models.",
        "operationId": "analyze_classification_analyze_classification_post",
        "parameters": [
          {
            "name": "features",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true,
              "title": "Features"
            },
            "description": "Comma-separated list of features to analyze. Available: genre, mood, tags, danceability, approachability, engagement, acoustic_electronic, bright_dark, instrument, tonal_atonal. Default: all."
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_file_upload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassificationAnalysis"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid feature name(s)"
          },
          "401": {
            "description": "Unauthorized - Invalid or missing API key"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/analyze/tonal": {
      "post": {
        "tags": ["Analysis"],
        "summary": "Analyze Tonal",
        "description": "Extract key, scale, deep-learning tempo (TempoCNN), and pitch (CREPE).",
        "operationId": "analyze_tonal_analyze_tonal_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_file_upload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnhancedTonalAnalysis"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing API key"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/analyze/vocals": {
      "post": {
        "tags": ["Analysis"],
        "summary": "Analyze Vocals",
        "description": "Detect whether audio contains vocals or is instrumental.",
        "operationId": "analyze_vocals_analyze_vocals_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_file_upload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VocalAnalysis"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing API key"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/analyze/full": {
      "post": {
        "tags": ["Analysis"],
        "summary": "Analyze Full",
        "description": "Perform full rhythm, structural, classification, tonal, and vocal analysis.",
        "operationId": "analyze_full_analyze_full_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_file_upload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FullAnalysis"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing API key"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Health",
        "description": "Check API health status.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_file_upload": {
        "type": "object",
        "required": ["file"],
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          }
        }
      },
      "EnergyData": {
        "type": "object",
        "required": ["mean", "std", "curve"],
        "properties": {
          "mean": {
            "type": "number",
            "title": "Mean"
          },
          "std": {
            "type": "number",
            "title": "Std"
          },
          "curve": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "title": "Curve"
          }
        }
      },
      "RhythmAnalysis": {
        "type": "object",
        "required": ["bpm", "beats", "confidence", "onsets", "duration", "energy"],
        "properties": {
          "bpm": {
            "type": "number",
            "title": "BPM"
          },
          "beats": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "title": "Beats"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "onsets": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "title": "Onsets"
          },
          "duration": {
            "type": "number",
            "title": "Duration"
          },
          "energy": {
            "$ref": "#/components/schemas/EnergyData"
          }
        }
      },
      "Section": {
        "type": "object",
        "required": ["start", "end", "label", "duration", "energy"],
        "properties": {
          "start": {
            "type": "number",
            "title": "Start"
          },
          "end": {
            "type": "number",
            "title": "End"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "duration": {
            "type": "number",
            "title": "Duration"
          },
          "energy": {
            "type": "number",
            "title": "Energy"
          }
        }
      },
      "StructureAnalysis": {
        "type": "object",
        "required": ["sections", "boundaries"],
        "properties": {
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Section"
            },
            "title": "Sections"
          },
          "boundaries": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "title": "Boundaries"
          }
        }
      },
      "ClassificationResult": {
        "type": "object",
        "required": ["label", "confidence", "all_scores"],
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "all_scores": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "title": "All Scores"
          }
        }
      },
      "ClassificationFeature": {
        "type": "object",
        "required": ["label", "confidence"],
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          }
        }
      },
      "ClassificationAnalysis": {
        "type": "object",
        "properties": {
          "genres": {
            "anyOf": [
              { "$ref": "#/components/schemas/ClassificationResult" },
              { "type": "null" }
            ],
            "default": null,
            "title": "Genres"
          },
          "moods": {
            "anyOf": [
              { "$ref": "#/components/schemas/ClassificationResult" },
              { "type": "null" }
            ],
            "default": null,
            "title": "Moods"
          },
          "tags": {
            "anyOf": [
              {
                "type": "array",
                "items": { "type": "string" }
              },
              { "type": "null" }
            ],
            "default": null,
            "title": "Tags"
          },
          "danceability": {
            "anyOf": [
              { "$ref": "#/components/schemas/ClassificationFeature" },
              { "type": "null" }
            ],
            "default": null,
            "title": "Danceability"
          },
          "approachability": {
            "anyOf": [
              { "$ref": "#/components/schemas/ClassificationFeature" },
              { "type": "null" }
            ],
            "default": null,
            "title": "Approachability"
          },
          "engagement": {
            "anyOf": [
              { "$ref": "#/components/schemas/ClassificationFeature" },
              { "type": "null" }
            ],
            "default": null,
            "title": "Engagement"
          },
          "acoustic_electronic": {
            "anyOf": [
              { "$ref": "#/components/schemas/ClassificationFeature" },
              { "type": "null" }
            ],
            "default": null,
            "title": "Acoustic/Electronic"
          },
          "bright_dark": {
            "anyOf": [
              { "$ref": "#/components/schemas/ClassificationFeature" },
              { "type": "null" }
            ],
            "default": null,
            "title": "Bright/Dark"
          },
          "instrument": {
            "anyOf": [
              {
                "type": "array",
                "items": { "$ref": "#/components/schemas/ClassificationFeature" }
              },
              { "type": "null" }
            ],
            "default": null,
            "title": "Instrument"
          },
          "tonal_atonal": {
            "anyOf": [
              { "$ref": "#/components/schemas/ClassificationFeature" },
              { "type": "null" }
            ],
            "default": null,
            "title": "Tonal/Atonal"
          }
        }
      },
      "PitchData": {
        "type": "object",
        "required": ["mean_frequency", "confidence"],
        "properties": {
          "mean_frequency": {
            "type": "number",
            "title": "Mean Frequency"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          }
        }
      },
      "EnhancedTonalAnalysis": {
        "type": "object",
        "required": ["key", "scale", "strength"],
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "scale": {
            "type": "string",
            "title": "Scale"
          },
          "strength": {
            "type": "number",
            "title": "Strength"
          },
          "tempo_cnn": {
            "anyOf": [
              { "type": "number" },
              { "type": "null" }
            ],
            "default": null,
            "title": "Tempo CNN"
          },
          "pitch": {
            "anyOf": [
              { "$ref": "#/components/schemas/PitchData" },
              { "type": "null" }
            ],
            "default": null,
            "title": "Pitch"
          }
        }
      },
      "VocalAnalysis": {
        "type": "object",
        "required": ["vocal_presence", "label"],
        "properties": {
          "vocal_presence": {
            "type": "number",
            "title": "Vocal Presence",
            "description": "Continuous 0-1 score. 0.0 = instrumental, 1.0 = vocals."
          },
          "label": {
            "type": "string",
            "title": "Label"
          }
        }
      },
      "FullAnalysis": {
        "type": "object",
        "required": ["bpm", "beats", "confidence", "onsets", "duration", "energy", "structure"],
        "properties": {
          "bpm": {
            "type": "number",
            "title": "BPM"
          },
          "beats": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "title": "Beats"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "onsets": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "title": "Onsets"
          },
          "duration": {
            "type": "number",
            "title": "Duration"
          },
          "energy": {
            "$ref": "#/components/schemas/EnergyData"
          },
          "structure": {
            "$ref": "#/components/schemas/StructureAnalysis"
          },
          "classification": {
            "anyOf": [
              { "$ref": "#/components/schemas/ClassificationAnalysis" },
              { "type": "null" }
            ],
            "default": null,
            "title": "Classification"
          },
          "tonal": {
            "anyOf": [
              { "$ref": "#/components/schemas/EnhancedTonalAnalysis" },
              { "type": "null" }
            ],
            "default": null,
            "title": "Tonal"
          },
          "vocals": {
            "anyOf": [
              { "$ref": "#/components/schemas/VocalAnalysis" },
              { "type": "null" }
            ],
            "default": null,
            "title": "Vocals"
          }
        }
      },
      "HTTPValidationError": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail"
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "required": ["loc", "msg", "type"],
        "properties": {
          "loc": {
            "type": "array",
            "items": {
              "anyOf": [
                { "type": "string" },
                { "type": "integer" }
              ]
            },
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        }
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API Key required for authentication. Contact the administrator to receive your API key."
      }
    }
  }
}
